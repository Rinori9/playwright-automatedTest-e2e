{
     
  "compilerOptions": { 
    "target": "ES2021", 
    "module": "commonjs", 
    "lib": ["ES2021"], 
    "strict": true, 
    "esModuleInterop": true, 
    "skipLibCheck": true, 
    "forceConsistentCasingInFileNames": true, 
    "resolveJsonModule": true, 
    "outDir": "dist" 
  }, 
  "include": ["tests/**/*.ts", "pages/**/*.ts", "locators/**/*.ts", "test-data/**/*.ts", 
"playwright.config.ts"] 
} 